// Quantoom Root - Unified Quantum + AI + Cybersecurity Community App
// Database Schema - Prisma ORM 5.x / 6.x

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// -------------------------------------------------------------
// ENUMS
// -------------------------------------------------------------

enum UserRole {
  GUEST
  MEMBER
  VERIFIED_RESEARCHER
  MODERATOR
  ADMIN
  ENTERPRISE_ADMIN
  AI_AGENT
}

enum SubscriptionTier {
  FREE
  PRO
  ENTERPRISE_LAB
}

enum DomainCategory {
  QUANTUM
  AI
  CYBERSECURITY
  CONVERGENCE
}

enum QuantumGateType {
  H
  X
  Y
  Z
  S
  T
  RX
  RY
  RZ
  CNOT
  CZ
  SWAP
  TOFFOLI
  MEASURE
}

enum JobStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
  CANCELLED
}

enum CTFCategory {
  POST_QUANTUM_CRYPTO
  WEB_SECURITY
  REVERSE_ENGINEERING
  FORENSICS
  AI_RED_TEAMING
  NETWORK_DEFENSE
  CLOUD_SECURITY
}

enum ChallengeDifficulty {
  INTRO
  EASY
  MEDIUM
  HARD
  EXTREME
}

enum ThreatSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum IncidentStatus {
  OPEN
  INVESTIGATING
  CONTAINED
  ERADICATED
  RESOLVED
}

enum ProjectStatus {
  PLANNING
  ACTIVE
  REVIEW
  COMPLETED
  ARCHIVED
}

// -------------------------------------------------------------
// USER, PROFILE & GAMIFICATION MODELS
// -------------------------------------------------------------

model User {
  id                   String            @id @default(uuid())
  email                String            @unique
  username             String            @unique
  passwordHash         String
  role                 UserRole          @default(MEMBER)
  subscriptionTier     SubscriptionTier  @default(FREE)
  reputationPoints     Int               @default(100)
  pqcPublicKey         String?           // Dilithium / Kyber public key representation
  isMfaEnabled         Boolean           @default(false)
  mfaSecret            String?
  isActive             Boolean           @default(true)
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt

  profile              Profile?
  skills               UserSkill[]
  badges               UserBadge[]
  posts                Post[]
  comments             Comment[]
  votes                Vote[]
  reactions            Reaction[]
  bookmarks            Bookmark[]
  reportsFiled         Report[]          @relation("ReporterRelation")
  memberships          GroupMembership[]
  quantumCircuits      QuantumCircuit[]
  quantumJobs          QuantumJob[]
  providerCredentials  ProviderCredential[]
  aiConversations      AIConversation[]
  ctfSubmissions       CTFSubmission[]
  ctfWriteups          CTFWriteup[]
  projectMemberships   ProjectMember[]
  notifications        Notification[]
  auditLogs            AuditLog[]

  @@index([role])
  @@index([reputationPoints(sort: Desc)])
}

model Profile {
  id              String         @id @default(uuid())
  userId          String         @unique
  user            User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  displayName     String
  bio             String?
  avatarUrl       String?
  organization    String?
  academicDegrees String?
  githubHandle    String?
  orcid           String?
  primaryDomain   DomainCategory @default(CONVERGENCE)
  website         String?
  location        String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
}

model Skill {
  id          String         @id @default(uuid())
  name        String         @unique
  domain      DomainCategory
  description String?
  userSkills  UserSkill[]
}

model UserSkill {
  id         String   @id @default(uuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  skillId    String
  skill      Skill    @relation(fields: [skillId], references: [id], onDelete: Cascade)
  level      Int      @default(1) // 1-5
  endorsedBy Int      @default(0)

  @@unique([userId, skillId])
}

model Badge {
  id          String      @id @default(uuid())
  name        String      @unique
  description String
  domain      DomainCategory
  iconUrl     String
  criteria    String
  userBadges  UserBadge[]
}

model UserBadge {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  badgeId   String
  badge     Badge    @relation(fields: [badgeId], references: [id], onDelete: Cascade)
  awardedAt DateTime @default(now())

  @@unique([userId, badgeId])
}

// -------------------------------------------------------------
// COMMUNITY, FEEDS & SOCIAL MODELS
// -------------------------------------------------------------

model Group {
  id          String            @id @default(uuid())
  name        String            @unique
  slug        String            @unique
  description String
  domain      DomainCategory
  isPrivate   Boolean           @default(false)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  members     GroupMembership[]
  posts       Post[]
}

model GroupMembership {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  groupId   String
  group     Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  isAdmin   Boolean  @default(false)
  joinedAt  DateTime @default(now())

  @@unique([userId, groupId])
}

model Post {
  id             String          @id @default(uuid())
  title          String
  slug           String          @unique
  content        String          // Markdown + LaTeX + Circuit Embeds
  authorId       String
  author         User            @relation(fields: [authorId], references: [id], onDelete: Cascade)
  groupId        String?
  group          Group?          @relation(fields: [groupId], references: [id], onDelete: SetNull)
  domain         DomainCategory
  isQuestion     Boolean         @default(false)
  acceptedAnswerId String?
  upvoteCount    Int             @default(0)
  commentCount   Int             @default(0)
  viewCount      Int             @default(0)
  isPinned       Boolean         @default(false)
  isLocked       Boolean         @default(false)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  comments       Comment[]
  votes          Vote[]
  reactions      Reaction[]
  bookmarks      Bookmark[]
  reports        Report[]

  @@index([domain])
  @@index([createdAt(sort: Desc)])
  @@index([upvoteCount(sort: Desc)])
}

model Comment {
  id          String     @id @default(uuid())
  content     String
  postId      String
  post        Post       @relation(fields: [postId], references: [id], onDelete: Cascade)
  authorId    String
  author      User       @relation(fields: [authorId], references: [id], onDelete: Cascade)
  parentId    String?
  parent      Comment?   @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies     Comment[]  @relation("CommentReplies")
  upvotes     Int        @default(0)
  isAccepted  Boolean    @default(false)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  votes       Vote[]

  @@index([postId])
}

model Vote {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  value     Int      // +1 or -1
  postId    String?
  post      Post?    @relation(fields: [postId], references: [id], onDelete: Cascade)
  commentId String?
  comment   Comment? @relation(fields: [commentId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, postId, commentId])
}

model Reaction {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  postId    String
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  emoji     String   // e.g. "⚛️", "🤖", "🛡️", "🚀", "💡"
  createdAt DateTime @default(now())

  @@unique([userId, postId, emoji])
}

model Bookmark {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  postId    String
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, postId])
}

model Report {
  id         String   @id @default(uuid())
  reporterId String
  reporter   User     @relation("ReporterRelation", fields: [reporterId], references: [id], onDelete: Cascade)
  postId     String?
  post       Post?    @relation(fields: [postId], references: [id], onDelete: Cascade)
  reason     String
  status     String   @default("PENDING") // PENDING, RESOLVED, DISMISSED
  createdAt  DateTime @default(now())
}

// -------------------------------------------------------------
// QUANTUM COMPUTING HUB MODELS
// -------------------------------------------------------------

model QuantumCircuit {
  id            String             @id @default(uuid())
  name          String
  description   String?
  numQubits     Int                @default(2)
  circuitData   Json               // Gate array: [{ gate: "H", targets: [0], params: [] }, ...]
  openQasmCode  String?
  authorId      String
  author        User               @relation(fields: [authorId], references: [id], onDelete: Cascade)
  isPublic      Boolean            @default(true)
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  simulations   SimulatorResult[]
  quantumJobs   QuantumJob[]

  @@index([authorId])
}

model SimulatorResult {
  id             String         @id @default(uuid())
  circuitId      String
  circuit        QuantumCircuit @relation(fields: [circuitId], references: [id], onDelete: Cascade)
  stateVector    Json           // Array of { state: "|00>", real: 0.7071, imag: 0.0, prob: 0.5 }
  blochAngles    Json           // Array per qubit: { qubit: 0, theta: 1.57, phi: 0.0, x: 1, y: 0, z: 0 }
  probabilities  Json           // Measurement outcome histogram: { "00": 512, "11": 512 }
  shots          Int            @default(1024)
  executionTimeMs Float
  createdAt      DateTime       @default(now())

  @@index([circuitId])
}

model ProviderCredential {
  id            String   @id @default(uuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  providerName  String   // "IBM_QUANTUM", "AWS_BRAKET", "AZURE_QUANTUM", "IONQ"
  encryptedKey  String   // AES-256-GCM / Post-Quantum encrypted token
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([userId, providerName])
}

model QuantumJob {
  id            String         @id @default(uuid())
  circuitId     String
  circuit       QuantumCircuit @relation(fields: [circuitId], references: [id], onDelete: Cascade)
  userId        String
  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider      String         // "INTERNAL_SIMULATOR", "IBM_QUANTUM_HERON", "BRAKET_RIGETTI"
  status        JobStatus      @default(PENDING)
  shots         Int            @default(1024)
  rawOutput     Json?
  errorMessage  String?
  startedAt     DateTime?
  completedAt   DateTime?
  createdAt     DateTime       @default(now())

  @@index([userId])
  @@index([status])
}

// -------------------------------------------------------------
// AI COPILOT & KNOWLEDGE ENGINE MODELS
// -------------------------------------------------------------

model AIConversation {
  id          String      @id @default(uuid())
  userId      String
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  title       String      @default("New Quantum-AI Research Session")
  systemPrompt String?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  messages    AIMessage[]
}

model AIMessage {
  id             String         @id @default(uuid())
  conversationId String
  conversation   AIConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender         String         // "USER", "ASSISTANT", "AGENT"
  content        String
  modelUsed      String?        // "gpt-4o", "gemini-1.5-pro", "claude-3-5-sonnet", "ollama-qwen"
  tokenCount     Int?
  citations      Json?          // Citations array with title, url, snippet, confidence
  codeReviewData Json?          // Security AST findings if applicable
  createdAt      DateTime       @default(now())
}

model DocumentEmbedding {
  id         String         @id @default(uuid())
  title      String
  sourceUrl  String?
  domain     DomainCategory
  chunkText  String
  embedding  Json           // Vector representation
  metadata   Json?
  createdAt  DateTime       @default(now())

  @@index([domain])
}

// -------------------------------------------------------------
// CYBERSECURITY RANGE & CTF MODELS
// -------------------------------------------------------------

model CTFChallenge {
  id             String              @id @default(uuid())
  title          String
  slug           String              @unique
  description    String              // Markdown description with challenge scenario
  category       CTFCategory
  difficulty     ChallengeDifficulty
  points         Int                 @default(100)
  flagHash       String              // Argon2id hash of standard flag "ROOT{...}"
  hints          Json                // Array of hint objects: [{ hint: "...", penalty: 10 }]
  dockerImage    String?             // Ephemeral container image for lab
  isSandboxed    Boolean             @default(true)
  solveCount     Int                 @default(0)
  firstBloodUser String?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  submissions    CTFSubmission[]
  writeups       CTFWriteup[]

  @@index([category])
  @@index([difficulty])
}

model CTFSubmission {
  id          String       @id @default(uuid())
  userId      String
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  challengeId String
  challenge   CTFChallenge @relation(fields: [challengeId], references: [id], onDelete: Cascade)
  isCorrect   Boolean
  pointsAwarded Int        @default(0)
  submittedAt DateTime     @default(now())

  @@index([userId])
  @@index([challengeId])
}

model CTFWriteup {
  id          String       @id @default(uuid())
  userId      String
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  challengeId String
  challenge   CTFChallenge @relation(fields: [challengeId], references: [id], onDelete: Cascade)
  content     String       // Educational writeup
  isApproved  Boolean      @default(false)
  createdAt   DateTime     @default(now())
}

model SIEMLog {
  id             String         @id @default(uuid())
  timestamp      DateTime       @default(now())
  sourceIp       String
  destIp         String
  protocol       String         // "TCP", "UDP", "TLSv1.3", "QKD-SIM"
  severity       ThreatSeverity
  eventCategory  String         // "BRUTE_FORCE", "QUANTUM_RECON", "EXPLOITATION"
  mitreTechnique String         // e.g. "T1588.006", "T1059"
  description    String
  rawPayload     Json?

  @@index([timestamp(sort: Desc)])
  @@index([severity])
  @@index([mitreTechnique])
}

model IncidentPlaybook {
  id          String         @id @default(uuid())
  title       String
  category    DomainCategory @default(CYBERSECURITY)
  description String
  steps       Json           // Steps checklist: [{ step: 1, action: "Isolate Endpoint", command: "..." }]
  cveRefs     String[]
  createdAt   DateTime       @default(now())
}

// -------------------------------------------------------------
// CONVERGENCE PROJECTS & HACKATHONS
// -------------------------------------------------------------

model ConvergenceProject {
  id          String          @id @default(uuid())
  title       String
  slug        String          @unique
  description String
  status      ProjectStatus   @default(ACTIVE)
  bountyUsd   Float?          @default(0)
  githubRepo  String?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  members     ProjectMember[]
  tasks       ProjectTask[]
}

model ProjectMember {
  id        String             @id @default(uuid())
  userId    String
  user      User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  projectId String
  project   ConvergenceProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  role      String             @default("CONTRIBUTOR") // LEAD, CONTRIBUTOR, REVIEWER
  joinedAt  DateTime           @default(now())

  @@unique([userId, projectId])
}

model ProjectTask {
  id          String             @id @default(uuid())
  projectId   String
  project     ConvergenceProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  title       String
  description String?
  isCompleted Boolean            @default(false)
  assignedTo  String?
  dueDate     DateTime?
  createdAt   DateTime           @default(now())
}

// -------------------------------------------------------------
// AUDIT, NOTIFICATIONS & SYSTEM CONFIG
// -------------------------------------------------------------

model Notification {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  message   String
  link      String?
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId, isRead])
}

model AuditLog {
  id         String   @id @default(uuid())
  userId     String?
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action     String   // e.g. "AUTH_LOGIN", "QUANTUM_JOB_SUBMIT", "FLAG_VERIFY"
  ipAddress  String?
  userAgent  String?
  metadata   Json?
  timestamp  DateTime @default(now())

  @@index([action])
  @@index([timestamp(sort: Desc)])
}

model FeatureFlag {
  id          String   @id @default(uuid())
  key         String   @unique
  isEnabled   Boolean  @default(false)
  description String?
  rolloutPct  Int      @default(100)
}
